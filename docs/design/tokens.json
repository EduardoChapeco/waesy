{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "primitive": {
    "color": {
      "neutral": {
        "0": { "$type": "color", "$value": "#ffffff" },
        "50": { "$type": "color", "$value": "#f9fafb" },
        "100": { "$type": "color", "$value": "#f3f4f6" },
        "200": { "$type": "color", "$value": "#e5e7eb" },
        "300": { "$type": "color", "$value": "#d1d5db" },
        "400": { "$type": "color", "$value": "#9ca3af" },
        "500": { "$type": "color", "$value": "#6b7280" },
        "600": { "$type": "color", "$value": "#4b5563" },
        "700": { "$type": "color", "$value": "#374151" },
        "800": { "$type": "color", "$value": "#1f2937" },
        "900": { "$type": "color", "$value": "#111827" },
        "950": { "$type": "color", "$value": "#030712" }
      },
      "red": {
        "50": { "$type": "color", "$value": "#fef2f2" },
        "100": { "$type": "color", "$value": "#fee2e2" },
        "500": { "$type": "color", "$value": "#ef4444" },
        "600": { "$type": "color", "$value": "#dc2626" },
        "700": { "$type": "color", "$value": "#b91c1c" }
      },
      "green": {
        "50": { "$type": "color", "$value": "#f0fdf4" },
        "100": { "$type": "color", "$value": "#dcfce7" },
        "500": { "$type": "color", "$value": "#22c55e" },
        "600": { "$type": "color", "$value": "#16a34a" },
        "700": { "$type": "color", "$value": "#15803d" }
      },
      "amber": {
        "50": { "$type": "color", "$value": "#fffbeb" },
        "100": { "$type": "color", "$value": "#fef3c7" },
        "500": { "$type": "color", "$value": "#f59e0b" },
        "600": { "$type": "color", "$value": "#d97706" },
        "700": { "$type": "color", "$value": "#b45309" }
      },
      "blue": {
        "50": { "$type": "color", "$value": "#eff6ff" },
        "100": { "$type": "color", "$value": "#dbeafe" },
        "500": { "$type": "color", "$value": "#3b82f6" },
        "600": { "$type": "color", "$value": "#2563eb" },
        "700": { "$type": "color", "$value": "#1d4ed8" }
      }
    },
    "space": {
      "0": { "$type": "dimension", "$value": "0px" },
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "4": { "$type": "dimension", "$value": "16px" },
      "5": { "$type": "dimension", "$value": "20px" },
      "6": { "$type": "dimension", "$value": "24px" },
      "8": { "$type": "dimension", "$value": "32px" },
      "10": { "$type": "dimension", "$value": "40px" },
      "12": { "$type": "dimension", "$value": "48px" },
      "16": { "$type": "dimension", "$value": "64px" }
    },
    "radius": {
      "none": { "$type": "dimension", "$value": "0px" },
      "sm": { "$type": "dimension", "$value": "4px" },
      "md": { "$type": "dimension", "$value": "8px" },
      "lg": { "$type": "dimension", "$value": "12px" },
      "full": { "$type": "dimension", "$value": "9999px" }
    },
    "fontFamily": {
      "sans": { "$type": "fontFamily", "$value": "Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif" },
      "mono": { "$type": "fontFamily", "$value": "JetBrains Mono, monospace" }
    },
    "fontSize": {
      "xs": { "$type": "dimension", "$value": "12px" },
      "sm": { "$type": "dimension", "$value": "14px" },
      "base": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "18px" },
      "xl": { "$type": "dimension", "$value": "20px" },
      "2xl": { "$type": "dimension", "$value": "24px" },
      "3xl": { "$type": "dimension", "$value": "30px" },
      "4xl": { "$type": "dimension", "$value": "36px" }
    },
    "duration": {
      "fast": { "$type": "duration", "$value": "150ms" },
      "base": { "$type": "duration", "$value": "200ms" },
      "slow": { "$type": "duration", "$value": "300ms" }
    },
    "easing": {
      "out": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] },
      "inOut": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1] }
    },
    "elevation": {
      "none": { "$type": "shadow", "$value": "none" },
      "overlay": { "$type": "shadow", "$value": "0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -2px rgba(0, 0, 0, 0.04)" }
    },
    "zIndex": {
      "base": { "$type": "number", "$value": 0 },
      "raised": { "$type": "number", "$value": 10 },
      "dropdown": { "$type": "number", "$value": 20 },
      "sticky": { "$type": "number", "$value": 30 },
      "overlay": { "$type": "number", "$value": 40 },
      "modal": { "$type": "number", "$value": 50 }
    }
  },
  "semantic": {
    "surface": {
      "canvas": { "$type": "color", "$value": "{primitive.color.neutral.0}" },
      "card": { "$type": "color", "$value": "{primitive.color.neutral.0}" },
      "subtle": { "$type": "color", "$value": "{primitive.color.neutral.50}" },
      "muted": { "$type": "color", "$value": "{primitive.color.neutral.100}" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{primitive.color.neutral.900}" },
      "secondary": { "$type": "color", "$value": "{primitive.color.neutral.600}" },
      "muted": { "$type": "color", "$value": "{primitive.color.neutral.500}" },
      "inverse": { "$type": "color", "$value": "{primitive.color.neutral.0}" }
    },
    "border": {
      "default": { "$type": "color", "$value": "{primitive.color.neutral.200}" },
      "subtle": { "$type": "color", "$value": "{primitive.color.neutral.100}" },
      "control": { "$type": "color", "$value": "{primitive.color.neutral.400}" },
      "focus": { "$type": "color", "$value": "{primitive.color.neutral.900}" }
    },
    "feedback": {
      "danger": { "$type": "color", "$value": "{primitive.color.red.600}" },
      "dangerSubtle": { "$type": "color", "$value": "{primitive.color.red.50}" },
      "warning": { "$type": "color", "$value": "{primitive.color.amber.600}" },
      "warningSubtle": { "$type": "color", "$value": "{primitive.color.amber.50}" },
      "success": { "$type": "color", "$value": "{primitive.color.green.600}" },
      "successSubtle": { "$type": "color", "$value": "{primitive.color.green.50}" },
      "info": { "$type": "color", "$value": "{primitive.color.blue.600}" },
      "infoSubtle": { "$type": "color", "$value": "{primitive.color.blue.50}" }
    },
    "layout": {
      "gutterCompact": { "$type": "dimension", "$value": "{primitive.space.4}" },
      "gutterMedium": { "$type": "dimension", "$value": "{primitive.space.6}" },
      "gutterExpanded": { "$type": "dimension", "$value": "{primitive.space.8}" },
      "maxWidthApp": { "$type": "dimension", "$value": "1440px" }
    }
  },
  "component": {
    "button": {
      "primaryBg": { "$type": "color", "$value": "{semantic.text.primary}" },
      "primaryText": { "$type": "color", "$value": "{semantic.text.inverse}" },
      "secondaryBg": { "$type": "color", "$value": "{semantic.surface.canvas}" },
      "secondaryBorder": { "$type": "color", "$value": "{semantic.border.default}" },
      "secondaryText": { "$type": "color", "$value": "{semantic.text.primary}" },
      "dangerBg": { "$type": "color", "$value": "{semantic.feedback.danger}" },
      "dangerText": { "$type": "color", "$value": "{semantic.text.inverse}" },
      "touchTargetHeight": { "$type": "dimension", "$value": "44px" },
      "desktopHeight": { "$type": "dimension", "$value": "36px" },
      "radius": { "$type": "dimension", "$value": "{primitive.radius.md}" }
    },
    "input": {
      "bg": { "$type": "color", "$value": "{semantic.surface.canvas}" },
      "border": { "$type": "color", "$value": "{semantic.border.control}" },
      "borderActive": { "$type": "color", "$value": "{semantic.border.focus}" },
      "text": { "$type": "color", "$value": "{semantic.text.primary}" },
      "touchTargetHeight": { "$type": "dimension", "$value": "44px" },
      "radius": { "$type": "dimension", "$value": "{primitive.radius.md}" }
    },
    "card": {
      "bg": { "$type": "color", "$value": "{semantic.surface.card}" },
      "border": { "$type": "color", "$value": "{semantic.border.default}" },
      "radius": { "$type": "dimension", "$value": "{primitive.radius.lg}" },
      "padding": { "$type": "dimension", "$value": "{primitive.space.4}" }
    },
    "badge": {
      "neutralBg": { "$type": "color", "$value": "{semantic.surface.subtle}" },
      "neutralText": { "$type": "color", "$value": "{semantic.text.secondary}" },
      "dangerBg": { "$type": "color", "$value": "{semantic.feedback.dangerSubtle}" },
      "dangerText": { "$type": "color", "$value": "{semantic.feedback.danger}" },
      "successBg": { "$type": "color", "$value": "{semantic.feedback.successSubtle}" },
      "successText": { "$type": "color", "$value": "{semantic.feedback.success}" },
      "radius": { "$type": "dimension", "$value": "{primitive.radius.full}" }
    },
    "table": {
      "rowHeightCompact": { "$type": "dimension", "$value": "36px" },
      "rowHeightNormal": { "$type": "dimension", "$value": "44px" },
      "border": { "$type": "color", "$value": "{semantic.border.subtle}" }
    },
    "dialog": {
      "overlayBg": { "$type": "color", "$value": "rgba(0, 0, 0, 0.4)" },
      "maxHeight": { "$type": "dimension", "$value": "calc(100dvh - 2rem)" },
      "surfaceBg": { "$type": "color", "$value": "{semantic.surface.canvas}" },
      "radius": { "$type": "dimension", "$value": "{primitive.radius.lg}" },
      "shadow": { "$type": "shadow", "$value": "{primitive.elevation.overlay}" },
      "zIndex": { "$type": "number", "$value": "{primitive.zIndex.modal}" }
    },
    "sheet": {
      "surfaceBg": { "$type": "color", "$value": "{semantic.surface.canvas}" },
      "radius": { "$type": "dimension", "$value": "{primitive.radius.lg}" },
      "zIndex": { "$type": "number", "$value": "{primitive.zIndex.modal}" }
    }
  }
}
