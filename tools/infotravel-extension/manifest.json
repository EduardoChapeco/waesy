{
  "manifest_version": 3,
  "name": "Waesy Sync • Extensão de Operadoras (Infotravel)",
  "version": "2.1.0",
  "description": "Sincronizador inteligente e bilateral de cotações, reservas, passageiros e comissões para a agência Excelência Tour e ecossistema Waesy.",
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "*://*.orinter.com.br/*",
    "*://*.incomumviagens.com.br/*",
    "*://*.frt.com.br/*",
    "*://*.schultz.com.br/*",
    "*://*.infotravel.com.br/*",
    "*://waesy.com.br/*",
    "*://*.pages.dev/*",
    "*://localhost:*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Waesy Sync • Operadoras e Infotravel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.orinter.com.br/*",
        "*://*.incomumviagens.com.br/*",
        "*://*.frt.com.br/*",
        "*://*.schultz.com.br/*",
        "*://*.infotravel.com.br/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
