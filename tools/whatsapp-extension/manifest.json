{
  "manifest_version": 3,
  "name": "Waesy Ingest • Extensão WhatsApp Web (Grupos & Contatos)",
  "version": "2.2.0",
  "description": "Captura inteligente com rolagem virtualizada, sanitização e envio idempotente de contatos de grupos do WhatsApp Web para o Waesy CRM.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "*://waesy.com.br/*",
    "*://*.waesy.com.br/*",
    "*://*.pages.dev/*",
    "*://localhost:*/*",
    "*://127.0.0.1:*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Waesy Ingest • WhatsApp Web"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
