# ==============================================================================
# Waesy — Template Completo de Ambiente e Federação Multi-Supabase
# Copie para `.env` / `.env.local` (ambos no .gitignore) ou preencha via:
#   node scripts/ops/sync-topology-secrets.mjs --set-primary-runtime
# NUNCA commite chaves service_role, senhas de banco, PATs (sbp_*) ou VAULT_MASTER_KEY.
# ==============================================================================

# --- Aplicação / Cloudflare Pages ---
VITE_SITE_URL=https://usewaesy.pages.dev

# --- Nó 1: PRIMARY (Transacional, Auth, Storage, Multi-Tenant) ---
PROJECT_REF=wlxapubsesiwtxzbuygt
SUPABASE_PROJECT_REF=wlxapubsesiwtxzbuygt
VITE_SUPABASE_URL=https://wlxapubsesiwtxzbuygt.supabase.co
SUPABASE_URL=https://wlxapubsesiwtxzbuygt.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndseGFwdWJzZXNpd3R4emJ1eWd0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTUxMzE3NTIsImV4cCI6MjExMDcwNzc1Mn0.AUR8POSFFWuc7NCv_g7JX9nOMBWb8qBAqxTIXSi8VSI
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndseGFwdWJzZXNpd3R4emJ1eWd0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTUxMzE3NTIsImV4cCI6MjExMDcwNzc1Mn0.AUR8POSFFWuc7NCv_g7JX9nOMBWb8qBAqxTIXSi8VSI
VITE_SUPABASE_PUBLISHABLE_KEY=<PREENCHER_DA_DASHBOARD_OU_CLOUDFLARE>
SUPABASE_SERVICE_ROLE_KEY=<PREENCHER_VIA_SYNC_TOPOLOGY_SECRETS>
SUPABASE_DB_PASSWORD=<PREENCHER_VIA_COFRE>
SUPABASE_DB_URL=<PREENCHER_VIA_COFRE>
DATABASE_URL=<PREENCHER_VIA_COFRE>
SUPABASE_ACCESS_TOKEN=<PREENCHER_PAT_CONTA_PRIMARY>

# --- Topologia da Federação (dual | single | self-hosted) ---
# Use "dual" para descarregar mineração/logs no OFFLOAD, ou "single" para consolidar tudo em um único Supabase/Self-Hosted.
SUPABASE_TOPOLOGY_MODE=dual
SUPABASE_ROUTE_MINING=offload

# --- Nó 2: OFFLOAD / APOIO (Ingestão Pesada, Mineração, Telemetria, Filas) ---
SUPABASE_OFFLOAD_REF=vnmqummmgvgyazglnoav
SUPABASE_OFFLOAD_URL=https://vnmqummmgvgyazglnoav.supabase.co
SUPABASE_OFFLOAD_ANON_KEY=<PREENCHER_VIA_SYNC_TOPOLOGY_SECRETS>
SUPABASE_OFFLOAD_SERVICE_ROLE_KEY=<PREENCHER_VIA_SYNC_TOPOLOGY_SECRETS>

# --- Nó 3: ARCHIVE / LEGADO (Backup Histórico / Apoio Opcional) ---
SUPABASE_ARCHIVE_REF=jfuebqmltksyznovhlwa
SUPABASE_ARCHIVE_URL=https://jfuebqmltksyznovhlwa.supabase.co
SUPABASE_ARCHIVE_SERVICE_ROLE_KEY=<OPCIONAL_VIA_SYNC_TOPOLOGY_SECRETS>

# --- Criptografia & Sessão (Zero-Trust) ---
JWT_SECRET=<PREENCHER_VIA_COFRE>
VAULT_MASTER_KEY=<PREENCHER_VIA_COFRE>

# --- Integrações WhatsApp / Evolution ---
EVOLUTION_API_URL=<PREENCHER_VIA_COFRE>
EVOLUTION_API_KEY=<PREENCHER_VIA_COFRE>
