# -----------------------------------------------------------------------------
# 3. Federação Multi-Supabase (Primary + Offload + Archive)
# -----------------------------------------------------------------------------
# Modo: "auto" | "dual" | "single"
SUPABASE_TOPOLOGY_MODE="auto"
# "0" (recomendado até separar 12 embeds cross-node) ou "1"
SUPABASE_ROUTE_MINING="0"

# Nó Primary explícito (para .env.secrets / scripts/ops)
SUPABASE_PRIMARY_REF="wlxapubsesiwtxzbuygt"
SUPABASE_PRIMARY_URL="https://wlxapubsesiwtxzbuygt.supabase.co"
SUPABASE_PRIMARY_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndseGFwdWJzZXNpd3R4emJ1eWd0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTUxMzE3NTIsImV4cCI6MjExMDcwNzc1Mn0.AUR8POSFFWuc7NCv_g7JX9nOMBWb8qBAqxTIXSi8VSI"
SUPABASE_PRIMARY_SERVICE_ROLE_KEY="<SECRET_FROM_PRIMARY>"
SUPABASE_PRIMARY_ACCESS_TOKEN="<SECRET_PAT_PRIMARY>"
SUPABASE_PRIMARY_DB_PASSWORD="<SECRET_POSTGRES_PASSWORD>"

# Nó Offload (vnmqummmgvgyazglnoav — Logs, Telemetria, Filas, Ingestão)
SUPABASE_OFFLOAD_REF="vnmqummmgvgyazglnoav"
SUPABASE_OFFLOAD_URL="https://vnmqummmgvgyazglnoav.supabase.co"
SUPABASE_OFFLOAD_ANON_KEY="<ANON_KEY_FROM_OFFLOAD>"
SUPABASE_OFFLOAD_SERVICE_ROLE_KEY="<SECRET_FROM_OFFLOAD>"
SUPABASE_OFFLOAD_ACCESS_TOKEN="<SECRET_PAT_OFFLOAD>"
SUPABASE_OFFLOAD_DB_PASSWORD="<SECRET_POSTGRES_PASSWORD>"

# Nó Archive (jfuebqmltksyznovhlwa — Legado/Arquivo; opcional)
SUPABASE_ARCHIVE_ENABLED="0"
SUPABASE_ARCHIVE_REF="jfuebqmltksyznovhlwa"
