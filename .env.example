# =============================================================================
# Waesy — Template Completo de Variáveis de Ambiente (.env.example)
# =============================================================================
# Copie este arquivo para `.env` (ou use `node scripts/ops/sync-topology-secrets.mjs --set-primary-runtime`)
# NUNCA commite chaves privadas (`service_role`, `sbp_*`, senhas Postgres, `JWT_SECRET`, `VAULT_MASTER_KEY`).
# Documentação completa de bootstrap em outro computador: docs/ops/SUPABASE_FEDERATION_SETUP.md

# -----------------------------------------------------------------------------
# 1. Frontend / Públicas (Browser-Safe)
# -----------------------------------------------------------------------------
VITE_SITE_URL="https://usewaesy.pages.dev"
VITE_SUPABASE_URL="https://wlxapubsesiwtxzbuygt.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndseGFwdWJzZXNpd3R4emJ1eWd0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTUxMzE3NTIsImV4cCI6MjExMDcwNzc1Mn0.AUR8POSFFWuc7NCv_g7JX9nOMBWb8qBAqxTIXSi8VSI"
